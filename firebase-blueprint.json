{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile and subscription metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user unique identifier"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro", "ultra"],
          "description": "Active subscription plan"
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp in ISO 8601"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last login timestamp in ISO 8601"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Private user account documents strictly accessible only by the authenticated owner"
    }
  }
}
